{
  "name": "storybook-vue",
  "root": "apps/storybook-vue",
  "sourceRoot": "apps/storybook-vue/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:vue"
  ],
  "implicitDependencies": [
    "krds-vue",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-vue build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-vue typecheck"
      }
    },
    "test": {
      "dependsOn": [
        "storybook-build",
        "^build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-vue test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-vue lint"
      }
    },
    "storybook-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-vue storybook-build:local"
      },
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "stories": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:stories --framework vue"
      },
      "cache": false,
      "dependsOn": [
        "storybook-build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/story-cases.json",
        "{workspaceRoot}/catalog/story-coverage.json",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/tools/testing/**/*",
        "{workspaceRoot}/tools/run-story-tests.mjs"
      ]
    }
  }
}
