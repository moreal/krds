{
  "name": "fixture-lit",
  "root": "apps/fixture-lit",
  "sourceRoot": "apps/fixture-lit/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:lit"
  ],
  "implicitDependencies": [
    "krds-lit",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-lit build:local"
      },
      "outputs": [
        "{projectRoot}/dist/index.html",
        "{projectRoot}/dist/harness.html",
        "{projectRoot}/dist/hydrate.html",
        "{projectRoot}/dist/gallery.html",
        "{projectRoot}/dist/assets",
        "{projectRoot}/dist/local",
        "{projectRoot}/dist/local-assets",
        "{projectRoot}/dist/_legal"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-lit typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-lit test"
      },
      "dependsOn": [
        "build",
        "^build"
      ],
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-lit lint"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:contract --framework lit"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/specs/components/**/*",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/packages/test-contracts/**/*",
        "{workspaceRoot}/compatibility/testing.json"
      ]
    },
    "docs-preview": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/docs-preview"
      ],
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-lit docs-preview:local"
      }
    }
  }
}
