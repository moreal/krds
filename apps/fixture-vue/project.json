{
  "name": "fixture-vue",
  "root": "apps/fixture-vue",
  "sourceRoot": "apps/fixture-vue/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:vue"
  ],
  "implicitDependencies": [
    "krds-vue",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-vue build:local"
      },
      "outputs": [
        "{projectRoot}/dist/index.html",
        "{projectRoot}/dist/assets",
        "{projectRoot}/dist/local",
        "{projectRoot}/dist/local-assets",
        "{projectRoot}/dist/_legal"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-vue typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-vue test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-vue lint"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:contract --framework vue"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/tools/testing/**/*",
        "{workspaceRoot}/tools/run-contract-tests.mjs",
        "{workspaceRoot}/tools/run-siheom-tests.mjs"
      ]
    },
    "siheom": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:siheom --framework vue"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/tools/testing/**/*",
        "{workspaceRoot}/tools/run-contract-tests.mjs",
        "{workspaceRoot}/tools/run-siheom-tests.mjs"
      ]
    },
    "docs-preview": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist/docs-preview"
      ],
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-vue docs-preview:local"
      }
    }
  }
}
