{
  "name": "fixture-angular",
  "root": "apps/fixture-angular",
  "sourceRoot": "apps/fixture-angular/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:angular"
  ],
  "implicitDependencies": [
    "krds-angular",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-angular build:local"
      },
      "outputs": [
        "{projectRoot}/dist/index.html",
        "{projectRoot}/dist/main.js",
        "{projectRoot}/dist/styles.css",
        "{projectRoot}/dist/3rdpartylicenses.txt",
        "{projectRoot}/dist/local",
        "{projectRoot}/dist/local-assets",
        "{projectRoot}/dist/_legal"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-angular typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-angular test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-angular lint"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:contract --framework angular"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "siheom": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:siheom --framework angular"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "docs-preview": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist/docs-preview"
      ],
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-angular docs-preview:local"
      }
    }
  }
}
