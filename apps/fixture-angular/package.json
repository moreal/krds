    "@angular/cli": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@siheom/angular": "0.3.2",
    "@siheom/core": "0.4.1",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.10",
    "ng-packagr": "22.2.5",
    "playwright": "1.64.1",
