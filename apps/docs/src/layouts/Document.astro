---
import '@unofficial-krds/styles/reset.css';
import '@unofficial-krds/fonts/fonts.css';
import '@unofficial-krds/tokens/tokens.css';
import '@unofficial-krds/styles/base.css';
import '@unofficial-krds/styles/skip-link.css';
import '@unofficial-krds/styles/header.css';
import '@unofficial-krds/styles/main-menu.css';
import '@unofficial-krds/styles/side-navigation.css';
import '@unofficial-krds/styles/breadcrumb.css';
import '@unofficial-krds/styles/in-page-navigation.css';
import '@unofficial-krds/styles/modal.css';
import '@unofficial-krds/styles/text-input.css';
import '@unofficial-krds/styles/structured-list.css';
import '@unofficial-krds/styles/button.css';
import '@unofficial-krds/styles/native-select.css';
import '@unofficial-krds/styles/link.css';
import '@unofficial-krds/styles/text-list.css';
import '@unofficial-krds/styles/table.css';
import '@unofficial-krds/styles/badge.css';
import '@unofficial-krds/styles/switch.css';
import '@unofficial-krds/styles/footer.css';
import '../styles/content.css';
import '../styles/layout.css';
import type { DocPage } from '../content';
import DocsShell from '../components/DocsShell';
import navigation from '../generated/navigation.json';
import { branding } from '../branding';
import fontRegular from '@unofficial-krds/fonts/fonts/PretendardGOV-Regular.woff2?url';
import fontBold from '@unofficial-krds/fonts/fonts/PretendardGOV-Bold.woff2?url';
interface Props { page: DocPage; }
const { page } = Astro.props;
const title = `${page.title} | ${branding.name}`;
const description = '각 프레임워크의 고유 렌더러로 구현하는 비공식 KRDS 컴포넌트. API, 출처와 지원 기록을 확인하세요.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(branding.social, Astro.site);
---
<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    {/* Fetch the two text faces before first paint: a late swap re-wraps Korean paragraphs. */}
    <link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBold} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={branding.favicon} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={branding.favicon32} type="image/png" sizes="32x32" />
    <link rel="icon" href={branding.faviconIco} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={branding.appleTouchIcon} sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={branding.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={branding.socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={branding.socialAlt} />
  </head>
  <body><DocsShell page={page} navigation={navigation} client:load /></body>
</html>
