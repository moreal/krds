{
  "name": "@unofficial-krds/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/docs.test.mjs",
    "lint": "node ../../tools/check-workspace.mjs",
    "build:local": "node scripts/generate.mjs && vitepress build . --outDir dist",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test:browser": "node --import ../../tools/testing/browser-cache-preload.mjs tests/browser.mjs",
    "test:reproducibility": "node tests/reproducibility.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.3",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "typescript": "6.0.2",
    "vitepress": "1.6.4",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@unofficial-krds/styles": "workspace:^",
    "@unofficial-krds/tokens": "workspace:^",
    "@unofficial-krds/vue": "workspace:^"
  }
}
