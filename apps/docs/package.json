{
  "name": "@unofficial-krds/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:branding": "node scripts/generate-branding.mjs",
    "test:branding": "node --test tests/branding.test.mjs && node --import ../../tools/testing/browser-cache-preload.mjs tests/branding-browser.mjs",
    "test": "node --test tests/docs.test.mjs",
    "lint": "node ../../tools/check-workspace.mjs",
    "build:local": "node scripts/assemble-previews.mjs && node scripts/generate.mjs && node scripts/generate-routes.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "typecheck": "node scripts/generate-routes.mjs && ASTRO_TELEMETRY_DISABLED=1 astro sync && astro-check --minimumFailingSeverity error && tsc -p tsconfig.json --noEmit",
    "test:pipeline": "node --test tests/astro-pipeline.test.mjs tests/astro-diagnostics.test.mjs",
    "test:browser": "node --import ../../tools/testing/browser-cache-preload.mjs tests/browser.mjs",
    "test:reproducibility": "node tests/reproducibility.mjs",
    "test:content": "node --test tests/content.test.mjs tests/public-rich-ssr.test.mjs && tsc -p tests/tsconfig.rich.json --noEmit",
    "test:content:browser": "node --import ../../tools/testing/browser-cache-preload.mjs tests/content-browser.mjs",
    "test:shell:browser": "node --import ../../tools/testing/browser-cache-preload.mjs tests/shell-browser.mjs",
    "test:previews": "node --test tests/native-previews.test.mjs",
    "test:previews:browser": "node --import ../../tools/testing/browser-cache-preload.mjs tests/native-previews-browser.mjs",
    "test:previews:browser:webkit": "node --import ../../tools/testing/browser-cache-preload.mjs tests/native-previews-browser.mjs --browser webkit",
    "test:previews:integration": "node --test ../../tools/docs-previews/provenance.test.mjs ../../tools/docs-previews/build-graph.test.mjs ../../tools/docs-previews/sibling-outputs.test.mjs ../../tools/docs-previews/ci-artifact.test.mjs",
    "test:layout:browser": "node --import ../../tools/testing/browser-cache-preload.mjs tests/layout-text-200-browser.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/solid-js": "7.1.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.3",
    "astro": "7.4.4",
    "fontkitten": "1.0.3",
    "marked": "18.1.2",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "sharp": "0.34.5",
    "solid-js": "1.9.18",
    "typescript": "6.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@unofficial-krds/contracts": "workspace:^",
    "@unofficial-krds/fonts": "workspace:^",
    "@unofficial-krds/solid": "workspace:^",
    "@unofficial-krds/styles": "workspace:^",
    "@unofficial-krds/tokens": "workspace:^"
  }
}
