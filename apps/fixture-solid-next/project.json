{
  "name": "fixture-solid-next",
  "root": "apps/fixture-solid-next",
  "sourceRoot": "apps/fixture-solid-next/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:solid-next"
  ],
  "implicitDependencies": [
    "krds-solid-next",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-solid-next build:local"
      },
      "outputs": [
        "{projectRoot}/dist/index.html",
        "{projectRoot}/dist/assets",
        "{projectRoot}/dist/_legal"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-solid-next typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-solid-next test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-solid-next lint"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "options": {
        "command": "node tools/yarn.mjs test:contract --framework solid-next"
      }
    },
    "docs-preview": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist/docs-preview"
      ],
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-solid-next docs-preview:local"
      }
    }
  }
}
