{
  "name": "storybook-angular",
  "root": "apps/storybook-angular",
  "sourceRoot": "apps/storybook-angular/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:angular"
  ],
  "implicitDependencies": [
    "krds-angular",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-angular build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-angular typecheck"
      }
    },
    "test": {
      "dependsOn": [
        "storybook-build",
        "^build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-angular test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-angular lint"
      }
    },
    "storybook-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-angular storybook-build:local"
      },
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "stories": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:stories --framework angular"
      },
      "cache": false,
      "dependsOn": [
        "storybook-build",
        "^build"
      ]
    }
  }
}
