  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@playwright/test": "1.64.1",
    "@storybook/web-components-vite": "10.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@vitest/browser-playwright": "4.1.10",
    "lit": "3.3.3",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@unofficial-krds/lit": "workspace:^",
