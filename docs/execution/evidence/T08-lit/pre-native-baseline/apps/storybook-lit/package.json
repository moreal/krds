{
  "name": "@unofficial-krds/storybook-lit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node ../../tools/run-story-tests.mjs --framework lit --probe",
    "lint": "node ../../tools/check-workspace.mjs",
