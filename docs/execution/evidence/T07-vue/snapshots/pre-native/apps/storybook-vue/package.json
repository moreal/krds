{
  "name": "@unofficial-krds/storybook-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "yarn stories",
    "lint": "node ../../tools/check-workspace.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "build:local": "yarn storybook-build:local",
    "storybook-build": "yarn storybook-build:local",
    "stories": "node ../../tools/run-story-tests.mjs --framework vue",
    "storybook-build:local": "storybook build --output-dir dist --disable-telemetry"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/vue3-vite": "10.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vue/compiler-sfc": "3.5.44",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.10",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@unofficial-krds/styles": "workspace:^",
    "@unofficial-krds/test-contracts": "workspace:^",
    "@unofficial-krds/tokens": "workspace:^",
    "@unofficial-krds/vue": "workspace:^"
  }
}
