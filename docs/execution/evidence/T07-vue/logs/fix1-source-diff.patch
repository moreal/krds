+      h('div', { inert: true }, [h('button', {}, 'Inert action')]),
+      h('details', {}, [
+        h('summary', { id: 'disclosure-summary' }, 'More information'),
+        h('input', { 'aria-label': 'Disclosure note' }),
+      ]),
+    ] },
+  });
