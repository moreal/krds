{
  "name": "storybook-vue",
  "root": "apps/storybook-vue",
  "sourceRoot": "apps/storybook-vue/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:vue"
  ],
  "implicitDependencies": [
    "krds-vue",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/storybook-vue build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/storybook-vue typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/storybook-vue test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/storybook-vue lint"
      }
    },
    "storybook-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/storybook-vue storybook-build"
      }
    },
    "stories": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/storybook-vue stories"
      }
    }
  }
}
