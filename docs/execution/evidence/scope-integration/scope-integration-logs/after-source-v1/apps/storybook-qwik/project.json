{
  "name": "storybook-qwik",
  "root": "apps/storybook-qwik",
  "sourceRoot": "apps/storybook-qwik/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:qwik"
  ],
  "implicitDependencies": [
    "krds-qwik",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-qwik build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-qwik typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-qwik test"
      },
      "cache": false,
      "dependsOn": [
        "storybook-build",
        "^build"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-qwik lint"
      }
    },
    "storybook-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/storybook-qwik storybook-build:local"
      }
    },
    "stories": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:stories --framework qwik"
      },
      "cache": false,
      "dependsOn": [
        "storybook-build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/catalog/story-cases.json",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/tools/run-contract-tests.mjs",
        "{workspaceRoot}/tools/run-siheom-tests.mjs",
        "{workspaceRoot}/tools/run-story-tests.mjs",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/tools/testing/**/*"
      ]
    }
  }
}
