{
  "name": "fixture-svelte",
  "root": "apps/fixture-svelte",
  "sourceRoot": "apps/fixture-svelte/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:svelte"
  ],
  "implicitDependencies": [
    "krds-svelte",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-svelte build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-svelte typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-svelte test"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-svelte lint"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-svelte contract"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/tools/testing/**/*",
        "{workspaceRoot}/tools/run-contract-tests.mjs"
      ]
    },
    "siheom": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-svelte siheom"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/tools/run-siheom-tests.mjs"
      ]
    }
  }
}
