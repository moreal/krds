{
  "name": "krds-fonts",
  "root": "packages/fonts",
  "sourceRoot": "packages/fonts/src",
  "projectType": "library",
  "tags": [
    "layer:shared"
  ],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fonts build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fonts typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fonts test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fonts lint"
      }
    }
  }
}
