    "@solidjs/web": "2.0.0-rc.19",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.64.1",
    "solid-js": "2.0.0-rc.19",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.10"
  },
  "description": "KRDS Native solid-next: T01 toolchain probe only",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "LICENSES",
    "ATTRIBUTION.md",
    "THIRD-PARTY-NOTICES.md",
