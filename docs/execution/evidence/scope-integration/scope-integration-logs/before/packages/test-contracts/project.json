{
  "name": "krds-test-contracts",
  "root": "packages/test-contracts",
  "sourceRoot": "packages/test-contracts/src",
  "projectType": "library",
  "tags": [
    "layer:test"
  ],
  "implicitDependencies": [
    "krds-contracts"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/test-contracts build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/test-contracts typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/test-contracts test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/test-contracts lint"
      }
    }
  }
}
