{
  "name": "krds-qwik",
  "root": "packages/qwik",
  "sourceRoot": "packages/qwik/src",
  "projectType": "library",
  "tags": [
    "layer:adapter",
    "framework:qwik"
  ],
  "implicitDependencies": [
    "krds-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/qwik build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/qwik typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/qwik test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/qwik lint"
      }
    }
  }
}
