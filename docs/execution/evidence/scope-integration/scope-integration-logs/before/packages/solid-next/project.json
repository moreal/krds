{
  "name": "krds-solid-next",
  "root": "packages/solid-next",
  "sourceRoot": "packages/solid-next/src",
  "projectType": "library",
  "tags": [
    "layer:adapter",
    "framework:solid-next"
  ],
  "implicitDependencies": [
    "krds-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/solid-next build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/solid-next typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/solid-next test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/solid-next lint"
      }
    }
  }
}
