{
  "name": "krds-angular",
  "root": "packages/angular",
  "sourceRoot": "packages/angular/src",
  "projectType": "library",
  "tags": [
    "layer:adapter",
    "framework:angular"
  ],
  "implicitDependencies": [
    "krds-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/angular build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/angular typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/angular test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/angular lint"
      }
    }
  }
}
