{
  "name": "krds-assets",
  "root": "packages/assets",
  "sourceRoot": "packages/assets/src",
  "projectType": "library",
  "tags": [
    "layer:shared"
  ],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/assets build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/assets typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/assets test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/assets lint"
      }
    }
  }
}
