{
  "name": "krds-vue",
  "root": "packages/vue",
  "sourceRoot": "packages/vue/src",
  "projectType": "library",
  "tags": [
    "layer:adapter",
    "framework:vue"
  ],
  "implicitDependencies": [
    "krds-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/vue build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/vue typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/vue test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/vue lint"
      }
    }
  }
}
