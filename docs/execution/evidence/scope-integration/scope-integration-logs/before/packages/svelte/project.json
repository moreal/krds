{
  "name": "krds-svelte",
  "root": "packages/svelte",
  "sourceRoot": "packages/svelte/src",
  "projectType": "library",
  "tags": [
    "layer:adapter",
    "framework:svelte"
  ],
  "implicitDependencies": [
    "krds-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/svelte build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/svelte typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/svelte test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @krds-native/svelte lint"
      }
    }
  }
}
