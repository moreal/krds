{
  "name": "@krds-native/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": "24.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "node tools/check-node.mjs",
    "verify:workspace": "node tools/check-workspace.mjs",
    "test:workspace": "node --test tools/check-workspace.test.mjs",
    "verify:catalog": "node tools/check-catalog.mjs",
    "generate:notices": "node tools/generate-notices.mjs",
    "verify:licenses": "node tools/verify-licenses.mjs",
    "test:notices": "node --test tools/tests/notices.test.mjs",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "prepublishOnly": "node tools/block-publish.mjs"
  },
  "devDependencies": {
    "@nx/js": "24.0.2",
    "@types/node": "24.13.3",
    "corepack": "0.36.0",
    "nx": "24.0.2",
    "typescript": "6.0.2"
  }
}
