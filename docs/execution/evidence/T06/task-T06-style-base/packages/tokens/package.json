{
  "name": "@krds-native/tokens",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test src/token-graph.test.ts src/outputs.test.ts",
    "lint": "node ../../tools/check-workspace.mjs",
    "prepublishOnly": "node ../../tools/block-publish.mjs",
    "build:local": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.2"
  },
  "description": "KRDS source-preserving design tokens",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "LICENSES",
    "ATTRIBUTION.md",
    "THIRD-PARTY-NOTICES.md",
    "provenance.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./source-map.json": "./dist/source-map.json"
  }
}
