{
  "name": "fixture-react",
  "root": "apps/fixture-react",
  "sourceRoot": "apps/fixture-react/src",
  "projectType": "application",
  "tags": [
    "layer:app",
    "framework:react"
  ],
  "implicitDependencies": [
    "krds-react",
    "krds-test-contracts",
    "krds-tokens",
    "krds-styles"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-react build:local"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-react typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-react test"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/fixture-react lint"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:contract --framework react"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/catalog/story-cases.json",
        "{workspaceRoot}/catalog/story-coverage.json",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/packages/test-contracts/**/*",
        "{workspaceRoot}/tools/run-*-tests.mjs",
        "{workspaceRoot}/specs/components/**/*",
        "{workspaceRoot}/compatibility/frameworks.json"
      ]
    },
    "siheom": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs test:siheom --framework react"
      },
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/catalog/story-cases.json",
        "{workspaceRoot}/catalog/story-coverage.json",
        "{workspaceRoot}/compatibility/testing.json",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/packages/test-contracts/**/*",
        "{workspaceRoot}/tools/run-*-tests.mjs",
        "{workspaceRoot}/specs/components/**/*",
        "{workspaceRoot}/compatibility/frameworks.json"
      ]
    }
  }
}
