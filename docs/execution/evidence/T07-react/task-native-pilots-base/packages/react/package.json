{
  "name": "@unofficial-krds/react",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test ../../tools/workspace-probe.test.mjs",
    "lint": "node ../../tools/check-workspace.mjs",
    "prepublishOnly": "node ../../tools/block-publish.mjs",
    "build:local": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.10"
  },
  "description": "KRDS Native react: T01 toolchain probe only",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "LICENSES",
    "ATTRIBUTION.md",
    "THIRD-PARTY-NOTICES.md",
    "provenance.json"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@ark-ui/react": "5.40.0",
    "@unofficial-krds/contracts": "workspace:^",
    "@unofficial-krds/styles": "workspace:^",
    "@unofficial-krds/tokens": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moreal/krds",
    "directory": "packages/react"
  }
}
