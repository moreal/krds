+  const parent = mode === 'single' ? '2024-02-28' : { start: '2024-02-10', end: '2024-02-12' };
+  const requested = mode === 'single' ? '2024-02-29' : { start: '2024-02-20', end: '2024-02-22' };
+  render(<form id="review2-confirm-form">
