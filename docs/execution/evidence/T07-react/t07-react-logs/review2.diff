+    <Button type="submit">Submit confirmed parent</Button>
+  </form>);
+  const form = document.getElementById('review2-confirm-form') as HTMLFormElement;
+  const submissions: Array<{ blocked: boolean; data: Array<[string, FormDataEntryValue]> }> = [];
