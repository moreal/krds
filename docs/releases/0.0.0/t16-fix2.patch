+}
+export function parseReview(text,scope){
+ requireFact(nonempty(text)&&text.length>500&&/^# /mu.test(text),'Original independent review report required');requireFact(!/NOT ACCEPTED|REQUEST CHANGES/iu.test(text.slice(0,3000)),'Independent review currently requests changes');
+ const scopeName=scope==='docs'?'documentation|docs':scope;
+ requireFact(new RegExp(scopeName,'iu').test(text)&&/independent|independently/iu.test(text),'Wrong independent review subject');
+ requireFact(/Accepted|spec verdict: PASS|quality verdict: PASS/iu.test(text),'No explicit scoped review acceptance');
