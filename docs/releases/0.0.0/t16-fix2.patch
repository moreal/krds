+/** Typed acceptance of native producer data; historical parsers never award a candidate. */
+import {readFile,readdir,realpath,stat} from 'node:fs/promises';
+import {resolve,join,relative,dirname} from 'node:path';
+import {createHash} from 'node:crypto';
+import {validateStep,nodeCommand,producerEnvironment} from './receipts.mjs';
+export const stable=['solid','react','svelte','vue','lit','qwik','angular'];
+export const hash=value=>createHash('sha256').update(value).digest('hex');
+export const blocked=message=>Object.assign(new Error(message),{code:'EVIDENCE_BLOCKED'});
+const requireFact=(value,message)=>{if(!value)throw blocked(message);};
+const nonempty=value=>typeof value==='string'&&value.trim().length>0;
+const identical=(a,b)=>JSON.stringify(a)===JSON.stringify(b);
+const exact=(a,b)=>Array.isArray(a)&&new Set(a).size===a.length&&a.length===b.length&&b.every(value=>a.includes(value));
+export const patternCases=['form-errors/error-summary-focus','form-errors/retry-success','form-errors/reset-cancels-pending','search-results/filter-resets-page','search-results/empty-results','search-results/retry-success','search-results/query-during-loading','consent-confirmation/required-refusal','consent-confirmation/optional-refusal-success','consent-confirmation/modal-focus-return','consent-confirmation/retry-in-dialog','service-layout/skip-main','service-layout/navigate-current','service-layout/narrow-navigation','service-layout/footer-policy'];
+export const manualCases=['speech-output','keyboard','media-controls','visually-hidden','media-equivalence','zoom-200-400','forced-colors','focus-visibility'];
+export async function bytes(root,path){
+ requireFact(nonempty(path),'Missing evidence path');root=await realpath(root);const file=await realpath(resolve(root,path));requireFact(file.startsWith(`${root}/`),'Evidence escapes repository');requireFact((await stat(file)).isFile(),'Evidence is not a file');return readFile(file);
+}
+export async function readRef(root,ref){
+ requireFact(ref&&Number.isInteger(ref.bytes)&&ref.bytes>0&&/^[a-f0-9]{64}$/u.test(ref.sha256),'Missing nonempty original evidence reference');const value=await bytes(root,ref.path);requireFact(value.length===ref.bytes&&hash(value)===ref.sha256,`Changed original evidence ${ref.path}`);return value;
+}
+export async function ref(root,path){const value=await bytes(root,path);return {path:relative(await realpath(root),await realpath(resolve(root,path))),bytes:value.length,sha256:hash(value)};}
+export function parsePatterns(raw,framework){
+ requireFact([...stable,'solid-next'].includes(framework),'Unknown native framework');const rows=Array.isArray(raw)?raw:raw?.results;requireFact(Array.isArray(rows)&&rows.length>=15,'Empty/filtered native pattern execution');
+ for(const row of rows)requireFact((row.passed===true||row.ok===true||row.pass===true)&&row.skipped!==true&&row.executed!==false&&(row.exitCode===undefined||row.exitCode===0)&&!row.error&&!row.failure&&(!row.errors||row.errors.length===0)&&(!row.external||row.external.length===0),`Native pattern failed/unexecuted: ${row.id??row.name}`);
