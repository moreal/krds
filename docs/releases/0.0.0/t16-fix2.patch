+}
+const omit=new Set(['node_modules','dist','public','.git','.nx','.angular','.vite','.svelte-kit','.cache','__screenshots__']);
+export function sourceRoots(kind,frameworks=stable){
+ requireFact(['patterns','documentation','preview','ci','manualAccessibility','independentReview'].includes(kind),'Unknown producer source kind');
+ const common=['tools','tests','packages/test-contracts','package.json','.yarnrc.yml','.yarn/releases','yarn.lock','compatibility/toolchain.json','compatibility/frameworks.json','compatibility/testing.json'];
+ if(kind==='patterns')return [...common,'packages/test-contracts/src/patterns','examples/pattern-specs','docs/patterns',...frameworks.flatMap(id=>[`packages/${id}/src`,`packages/${id}/examples/patterns`,`apps/fixture-${id}/src`,`apps/fixture-${id}/scripts`,`apps/fixture-${id}/tests`,`apps/fixture-${id}/public`,`apps/storybook-${id}/src`])];
+ if(kind==='manualAccessibility')return [...sourceRoots('patterns',frameworks),'docs/reviews','compliance/project-identity.json'];
+ if(kind==='independentReview')return [...sourceRoots('ci',frameworks),'docs/reviews'];
+ if(kind==='documentation')return [...common,'apps/docs','catalog','specs','compliance'];
+ if(kind==='preview')return [...common,'packages/solid-next','apps/fixture-solid-next','catalog/fixture-cases.json','tools/run-contract-tests.mjs','tools/testing'];
+ if(kind==='ci')return [...common,'tools/ci','.github/workflows','package.json','nx.json','packages','apps','tests','catalog','compliance'];
+ return [...common,'docs/reviews','compliance/project-identity.json'];
+}
+export async function inventory(root,roots,{outputs=false}={}){
+ const records=new Map();async function visit(path,required=false){let info;try{info=await stat(resolve(root,path));}catch(error){if(error.code==='ENOENT'&&!required)return;throw error;}if(info.isDirectory()){for(const entry of await readdir(resolve(root,path),{withFileTypes:true})){if(entry.name==='.DS_Store'||!outputs&&entry.name.endsWith('.tsbuildinfo')||omit.has(entry.name)&&!(outputs&&['dist','public'].includes(entry.name)))continue;requireFact(!entry.isSymbolicLink(),'Unexpected source/artifact symlink');await visit(`${path}/${entry.name}`);}}else if(info.isFile()){const value=await bytes(root,path);records.set(path,{path,bytes:value.length,sha256:hash(value)});}}
+ for(const path of roots)await visit(path,outputs);const files=[...records.values()].sort((a,b)=>a.path.localeCompare(b.path));requireFact(files.length>0,'Empty source/output inventory');return {roots,files,sha256:hash(JSON.stringify(files))};
+}
+export async function validateInventory(root,record,roots,options){const current=await inventory(root,roots,options);requireFact(identical(record,current),'Complete source/artifact inventory is stale or incomplete');return current;}
+export function candidateBinding(kind,candidate,scopes){
+ const scope=['patterns','manualAccessibility'].includes(kind)?'stable':kind==='preview'?'preview':'all';
+ if(scope!=='all'){requireFact(scopes?.[scope],'Missing accepted scoped source/artifact binding');return {sourceCommit:candidate.sourceCommit,lockfileSha256:candidate.lockfileSha256,scope,sourceFingerprint:scopes[scope].sourceFingerprint,artifactSetSha256:scopes[scope].artifactSetSha256};}
+ return {sourceCommit:candidate.sourceCommit,lockfileSha256:candidate.lockfileSha256,scope,sourceFingerprint:candidate.sourceFingerprint,repositorySourceSha256:candidate.repositorySourceSha256,artifactManifestSha256:candidate.artifactManifestSha256};
+}
