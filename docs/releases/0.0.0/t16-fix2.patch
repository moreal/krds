+#!/usr/bin/env node
+/** Run the actual T12 browser producer while recording exact consumed response bytes. */
+import {createRequire} from 'node:module';
+import {readFile,writeFile,mkdir} from 'node:fs/promises';
+import {resolve,dirname,relative} from 'node:path';
+import {createHash} from 'node:crypto';
+import {pathToFileURL} from 'node:url';
+import {redirectDocsProducer} from './producers.mjs';
+const root=resolve(import.meta.dirname,'../..'),dist=resolve(root,'apps/docs/dist');
+const producerOutput=process.env.KRDS_RELEASE_DOCS_OUTPUT;if(!producerOutput)throw new Error('A fresh redirected producer-output directory is required');
+const require=createRequire(resolve(root,'apps/docs/package.json'));
+const {chromium,webkit}=require('@playwright/test');const pending=[],responses=[],failures=[];const output=process.env.KRDS_RELEASE_DOCS_SERVED;
+if(!output)throw new Error('A retained served-response output path is required');
+for(const engine of [chromium,webkit]){const launch=engine.launch.bind(engine);engine.launch=async(...args)=>{const browser=await launch(...args),newContext=browser.newContext.bind(browser);browser.newContext=async(...options)=>{const context=await newContext(...options);context.on('response',response=>{pending.push((async()=>{
+ if(response.status()>=300&&response.status()<400)return;const url=new URL(response.url());if(!['localhost','127.0.0.1'].includes(url.hostname))throw new Error('Remote documentation response');if(response.status()!==200)throw new Error(`Documentation HTTP failure ${response.status()}`);
+ const path=decodeURIComponent(url.pathname);const choices=path.endsWith('/')?[`${path}index.html`]:[path,`${path}.html`,`${path}/index.html`];let file,expected;
+ for(const candidate of choices){const candidateFile=resolve(dist,`.${candidate}`);if(!candidateFile.startsWith(`${dist}/`))throw new Error('Unsafe docs response path');try{expected=await readFile(candidateFile);file=candidateFile;break;}catch(error){if(error.code!=='ENOENT')throw error;}}
+ if(!expected)throw new Error(`Response is outside current built docs ${path}`);const body=await response.body();if(!body.equals(expected))throw new Error(`Browser consumed different documentation bytes ${path}`);
+ responses.push({browser:engine.name(),url:response.url(),path:relative(root,file),bytes:body.length,sha256:createHash('sha256').update(body).digest('hex')});
+ })().catch(error=>{failures.push(error.message);}));});return context;};return browser;};}
+const source=await readFile(resolve(root,'apps/docs/tests/browser.mjs'),'utf8');const derived=redirectDocsProducer(source,root,producerOutput);const derivedPath=resolve(dirname(output),'t12-producer-redirected.mjs');await writeFile(derivedPath,derived);await import(pathToFileURL(derivedPath).href);await Promise.all(pending);if(failures.length)throw new Error(failures.join('; '));if(!responses.length)throw new Error('Zero actual docs response bytes captured');await mkdir(dirname(resolve(output)),{recursive:true});await writeFile(resolve(output),JSON.stringify({schemaVersion:1,kind:'actual-docs-responses',producerSha256:createHash('sha256').update(source).digest('hex'),redirectedProducer:{path:relative(root,derivedPath),sha256:createHash('sha256').update(derived).digest('hex'),bytes:Buffer.byteLength(derived)},producerOutput:relative(root,resolve(producerOutput)),responses},null,2)+'\n');
