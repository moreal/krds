+const docsChecks=['keyboard skip link reaches main','Korean local search returns Badge','54 catalog navigation rows','native semantic contract visible','local source download reachable','narrow document has no horizontal overflow','actual doubled computed text size','doubled-text navigation stays visible and opens','home and component axe violations zero','external runtime requests zero','browser errors zero'];
