+}
+export function parseHumanSession(session,required){
+ requireFact(nonempty(session?.person)&&session.role==='manual-reviewer'&&session.performed===true,'Actual human identity/performed session required');
+ requireFact(Number.isFinite(Date.parse(session.startedAt))&&Date.parse(session.finishedAt)>Date.parse(session.startedAt),'Actual session start/end required');
+ requireFact(['os','browser','assistiveTechnology'].every(key=>nonempty(session.environment?.[key])),'Actual OS/browser/assistive technology required');
