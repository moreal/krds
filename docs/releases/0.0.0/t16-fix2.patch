+#!/usr/bin/env node
+/** Assemble real captured receipts and explicitly authored review/session records. */
+import {readFile,writeFile,mkdir} from 'node:fs/promises';
+import {resolve,join,dirname} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {candidateBinding,capturedCandidateMatches,inspectReleaseEvidence,ref,stable} from './producers.mjs';
+const root=resolve(import.meta.dirname,'../..');
+export function assemble(kind,candidate,scopes,records,extras={}){
+ const first=records[0]??extras;const report={...extras,schemaVersion:3,kind,candidate:candidateBinding(kind,candidate,scopes),sourceBefore:first.sourceBefore,sourceAfter:first.sourceAfter};
+ if(kind==='patterns')report.rows=stable.map(framework=>{const row=records.find(record=>record.recipe==='patterns'&&record.framework===framework);if(!row)throw new Error(`Missing recorded native ${framework}`);return {framework,result:row.result,execution:row.execution,artifactsBefore:row.artifactsBefore,artifactsAfter:row.artifactsAfter,capture:row.captureRef,review:extras.reviews?.[framework]};});
+ else if(kind==='documentation'){const tests=records.find(record=>record.recipe==='docs-tests'),browser=records.find(record=>record.recipe==='docs-browser');if(!tests||!browser)throw new Error('Missing actual docs test/browser recordings');Object.assign(report,{testCapture:tests.captureRef,browserCapture:browser.captureRef,tests:tests.execution,browserExecution:browser.execution,browser:browser.result,served:browser.served,artifactsBefore:browser.artifactsBefore,artifactsAfter:browser.artifactsAfter});}
+ else if(kind==='ci'){report.steps=records.map(({recipe,execution,captureRef})=>({recipe,execution,capture:captureRef}));report.ci=first.ci;}
+ else if(kind==='preview'){const lookup=recipe=>{const record=records.find(record=>record.recipe===recipe);if(!record)throw new Error(`Missing ${recipe}`);return record;};Object.assign(report,{typeCapture:lookup('preview-types').captureRef,buildCapture:lookup('preview-build').captureRef,contractCapture:lookup('preview-contracts').captureRef,types:lookup('preview-types').execution,build:lookup('preview-build').execution,contractExecution:lookup('preview-contracts').execution,contractRaw:lookup('preview-contracts').result});}
+ for(const record of records)if(!capturedCandidateMatches(kind,record.candidate,report.candidate,report.sourceBefore)||JSON.stringify(record.sourceBefore)!==JSON.stringify(report.sourceBefore)||JSON.stringify(record.sourceAfter)!==JSON.stringify(report.sourceAfter))throw new Error('Recorded source candidates differ; cannot merge executions');
+ return report;
+}
+if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url)){
+ const opts={records:[]};for(let i=2;i<process.argv.length;i++){const key=process.argv[i],value=process.argv[++i];if(!value||!['--kind','--candidate','--manifest','--record','--extras','--output'].includes(key))throw new Error('Usage: assemble --kind KIND --candidate verification.json --manifest manifest.json [--record receipt.json] --extras human-or-metadata.json --output docs/releases/VERSION');if(key==='--record')opts.records.push(value);else opts[key.slice(2)]=value;}
+ const read=async path=>JSON.parse(await readFile(resolve(root,path),'utf8')),candidateDocument=await read(opts.candidate),candidate=candidateDocument.candidate??candidateDocument,manifest=await read(opts.manifest),records=await Promise.all(opts.records.map(async path=>({...await read(path),captureRef:await ref(root,path)}))),extras=opts.extras?await read(opts.extras):{};
+ const report=assemble(opts.kind,candidate,manifest.scopes,records,extras),directory=resolve(root,opts.output);if(!directory.startsWith(`${root}/docs/releases/`)&&!directory.startsWith(`${root}/test-results/`))throw new Error('Output must be retained release/test evidence');await mkdir(dirname(directory),{recursive:true});await mkdir(directory);const file=join(directory,`${opts.kind}.json`);await writeFile(file,JSON.stringify(report,null,2)+'\n');
+ const index={schemaVersion:3,reports:{[opts.kind]:await ref(root,file)}};const result=await inspectReleaseEvidence(root,opts.kind,index,candidate,manifest.scopes);if(result.status!=='passed')throw new Error(result.details.join('; '));await writeFile(join(directory,`${opts.kind}.index.json`),JSON.stringify(index,null,2)+'\n');console.log(JSON.stringify({status:'validated-producer-evidence',releaseAccepted:false,index:`${opts.kind}.index.json`}));
+}
