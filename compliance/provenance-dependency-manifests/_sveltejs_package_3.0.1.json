{
  "name": "@sveltejs/package",
  "version": "3.0.1",
  "description": "The fastest way to build Svelte packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/kit.git",
    "directory": "packages/package"
  },
  "keywords": [
    "build",
    "bundle",
    "component",
    "library",
    "packaging",
    "svelte",
    "tool"
  ],
  "license": "MIT",
  "homepage": "https://svelte.dev",
  "type": "module",
  "dependencies": {
    "@sveltejs/load-config": "^0.2.3",
    "chokidar": "^5.0.0",
    "svelte2tsx": "~0.7.60"
  },
  "devDependencies": {
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.19.19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "svelte": "^3.44.0 || ^4.0.0 || ^5.0.0-next.1",
    "typescript": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "bin": {
    "svelte-package": "svelte-package.js"
  },
  "files": [
    "src"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxfmt --check .",
    "check": "pnpm tsc-native",
    "check:all": "pnpm tsc-native && pnpm -r --filter=\"./**\" check",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "tsc-native": "node node_modules/@typescript/native/bin/tsc"
  }
}