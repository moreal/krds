{
  "name": "krds-tokens",
  "root": "packages/tokens",
  "sourceRoot": "packages/tokens/src",
  "projectType": "library",
  "tags": [
    "layer:shared",
    "npm-public"
  ],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/tokens build:local"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/upstream/krds/raw/kit/tokens/*.json",
        "{workspaceRoot}/upstream/krds/raw/kit/resources/css/token/krds_tokens.css"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/tokens typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/tokens test"
      },
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/upstream/krds/raw/kit/tokens/*.json",
        "{workspaceRoot}/upstream/krds/raw/kit/resources/css/token/krds_tokens.css"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/yarn.mjs workspace @unofficial-krds/tokens lint"
      }
    }
  }
}
