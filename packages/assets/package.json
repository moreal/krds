{
  "name": "@unofficial-krds/assets",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node ../../tools/verify-licenses.mjs",
    "lint": "node ../../tools/check-workspace.mjs",
    "prepublishOnly": "node ../../tools/block-publish.mjs",
    "build:local": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.2"
  },
  "description": "Local generic KRDS SVG icons with verified source records",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "LICENSES",
    "ATTRIBUTION.md",
    "THIRD-PARTY-NOTICES.md",
    "provenance.json",
    "icons"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": "./icons/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moreal/krds",
    "directory": "packages/assets"
  }
}
