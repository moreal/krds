{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "yarn"
  },
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/yarn.lock",
      "{workspaceRoot}/.yarnrc.yml",
      "{workspaceRoot}/.node-version",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/compatibility/toolchain.json",
      "{workspaceRoot}/compatibility/frameworks.json",
      "{workspaceRoot}/compatibility/testing.json",
      "{workspaceRoot}/tools/**/*",
      "{workspaceRoot}/compliance/**/*",
      "{workspaceRoot}/upstream/krds/manifest.json",
      "{workspaceRoot}/catalog/fixture-cases.json",
      "{workspaceRoot}/catalog/story-cases.json",
      "{workspaceRoot}/catalog/story-coverage.json",
      "{workspaceRoot}/specs/components/**/*",
      "{workspaceRoot}/LICENSE.md",
      "{workspaceRoot}/LICENSES/**/*",
      "{workspaceRoot}/ATTRIBUTION.md",
      "{workspaceRoot}/THIRD-PARTY-NOTICES.md",
      {
        "runtime": "node tools/check-node.mjs && node --version"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/.svelte-kit/**/*",
      "sharedGlobals"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "contract": {
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/specs/components/**/*",
        "{workspaceRoot}/compatibility/frameworks.json",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/packages/test-contracts/**/*"
      ]
    },
    "siheom": {
      "cache": false,
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/fixture-cases.json",
        "{workspaceRoot}/packages/test-contracts/**/*"
      ]
    },
    "stories": {
      "cache": false,
      "dependsOn": [
        "storybook-build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/story-cases.json",
        "{workspaceRoot}/catalog/story-coverage.json",
        "{workspaceRoot}/packages/test-contracts/**/*",
        "{workspaceRoot}/playwright.config.ts"
      ]
    },
    "storybook-build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/catalog/story-cases.json",
        "{workspaceRoot}/catalog/story-coverage.json",
        "{workspaceRoot}/packages/test-contracts/**/*"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "docs-preview": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/apps/docs/demo-definitions.json",
        "{workspaceRoot}/apps/docs/demo-acceptance.json",
        "{workspaceRoot}/catalog/**/*",
        "{workspaceRoot}/tools/docs-previews/**/*",
        "{workspaceRoot}/yarn.lock",
        "{workspaceRoot}/.yarnrc.yml",
        "{workspaceRoot}/compatibility/**/*",
        "{workspaceRoot}/compliance/**/*",
        "{workspaceRoot}/upstream/krds/manifest.json",
        "{workspaceRoot}/packages/styles/**/*",
        "{workspaceRoot}/packages/fonts/**/*",
        "{workspaceRoot}/packages/assets/**/*"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist/docs-preview"
      ]
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "versionPlans": true,
    "git": {
      "commit": false,
      "tag": false,
      "push": false,
      "stageChanges": false
    },
    "version": {
      "currentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": true,
      "updateDependents": "always",
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false
      }
    },
    "groups": {
      "stable": {
        "projects": [
          "krds-contracts",
          "krds-tokens",
          "krds-styles",
          "krds-assets",
          "krds-fonts",
          "krds-react",
          "krds-solid",
          "krds-svelte",
          "krds-vue",
          "krds-lit",
          "krds-qwik",
          "krds-angular"
        ],
        "projectsRelationship": "independent",
        "versionPlans": true
      },
      "solid2-preview": {
        "projects": [
          "krds-solid-next"
        ],
        "projectsRelationship": "independent",
        "versionPlans": true
      }
    }
  }
}
