{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "skipLibCheck": true, "experimentalDecorators": true, "isolatedModules": true,
    "noEmit": true, "types": ["node"]
